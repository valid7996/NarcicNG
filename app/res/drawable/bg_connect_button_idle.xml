<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <gradient android:gradientRadius="50%p" android:startColor="#0A2A22" android:endColor="#060E0C" android:type="radial" />
        </shape>
    </item>
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#0B1816" />
        </shape>
    </item>
    <item android:left="14dp" android:right="14dp" android:top="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <gradient android:gradientRadius="55%p" android:startColor="#1A322C" android:centerColor="#122420" android:endColor="#0D1A17" android:type="radial" />
        </shape>
    </item>
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1A4D3E" />
        </shape>
    </item>
    <item android:left="14dp" android:right="14dp" android:top="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="#1A3D32" />
        </shape>
    </item>
    <item android:left="30dp" android:right="30dp" android:top="18dp" android:bottom="60dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#15FFFFFF" android:endColor="#00FFFFFF" android:type="linear" />
        </shape>
    </item>
</layer-list>
