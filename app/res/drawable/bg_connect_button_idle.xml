<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer faint ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0AFFFFFF" />
        </shape>
    </item>
    <!-- middle ring -->
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
        </shape>
    </item>
    <!-- main button circle -->
    <item
        android:left="32dp"
        android:top="32dp"
        android:right="32dp"
        android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="#161B26" />
            <stroke
                android:width="1.5dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
