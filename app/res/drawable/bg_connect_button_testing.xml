<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="8dp" android:right="8dp" android:top="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient android:gradientRadius="50%p" android:startColor="#3D2E08" android:endColor="#1A1505" android:type="radial" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#1A1508" />
        </shape>
    </item>
    <item android:left="13dp" android:right="13dp" android:top="13dp" android:bottom="13dp">
        <shape android:shape="oval">
            <gradient android:startColor="#2A2008" android:centerColor="#3D2E0A" android:endColor="#1A1505" android:type="sweep" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#F9A73C" />
        </shape>
    </item>
    <item android:left="13dp" android:right="13dp" android:top="13dp" android:bottom="13dp">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="#F9A73C44" />
        </shape>
    </item>
</layer-list>
