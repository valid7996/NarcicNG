<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#22FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#18FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
            <padding
                android:bottom="0.5dp"
                android:left="0.5dp"
                android:right="0.5dp"
                android:top="0.5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
            <corners android:radius="17.5dp" />
        </shape>
    </item>
</layer-list>
